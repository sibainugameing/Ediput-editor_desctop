{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ediput",
  "version": "0.1.0",
  "identifier": "dev.ediput.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ediput",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Fast Markdown editor",
    "longDescription": "A fast local-first Markdown editor for macOS, Windows and Linux."
  }
}